# Copy to .env for reference. Locally the API (dev profile) falls back to the Docker dev
# service credentials; in production (prod profile) the REQUIRED values must be set.

# PostgreSQL (REQUIRED in production)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/nexhire_dev
SPRING_DATASOURCE_USERNAME=nexhire
SPRING_DATASOURCE_PASSWORD=

# JWT (REQUIRED in production: 32+ random characters, e.g. `openssl rand -hex 48`)
JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# First administrator: created on startup only while no admin exists (password 8+ characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# RabbitMQ (CloudAMQP in production: port 5671, SSL true)
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=nexhire
SPRING_RABBITMQ_PASSWORD=
SPRING_RABBITMQ_VIRTUAL_HOST=/
SPRING_RABBITMQ_SSL_ENABLED=false
# Alternative single URL. Takes priority over the variables above when set:
# SPRING_RABBITMQ_ADDRESSES=amqps://user:pass@host/vhost

# File storage: MinIO locally, Backblaze B2 in production (uploads are disabled without keys)
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000/nexhire-files
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=nexhire-files

# Email (optional): without SPRING_MAIL_HOST, emails are only logged
# (leave these commented out unless you have an SMTP provider — an empty host still enables sending)
# SPRING_MAIL_HOST=smtp-relay.brevo.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# MAIL_FROM=NexHire <no-reply@yourdomain.com>
# Frontend URL used in email links
APP_BASE_URL=http://localhost:3000

# CORS: comma-separated frontend URLs (add your Vercel URL in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Next.js (set on the frontend; rebuild after changing)
NEXT_PUBLIC_API_URL=http://localhost:8080/api
